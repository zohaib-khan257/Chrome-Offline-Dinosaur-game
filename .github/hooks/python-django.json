{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/validate-dangerous-commands.sh",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/post-edit-format.sh",
        "cwd": ".",
        "timeout": 120
      }
    ]
  }
}
